<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<style>
    body {
            font-family: 'Inter', sans-serif;
        }
</style>

<body class="bg-gray-50">
    <%- include('partials/header') %>

     <section class="bg-gray-50 py-20 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight uppercase">
                Explore our markets
            </h2>
            <p class="text-slate-500 mt-4 text-lg font-medium">
                We Manufacture our products for the niche industries
            </p>
            <div class="w-20 h-1 bg-yellow-500 mx-auto mt-6"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
            <% 
            const industries = [
                { title: "Water Supply & Distribution", desc: "Products Used in: Lift Irrigation or Supply Water Transportation, Domestic Water Supply.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Sewerage & STP", desc: "Products Used in: Sewerage Conveyance Primary, Sewerage Treatment, Flood & Storm Water Management.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Desalination Plant", desc: "Products Used in: Sea-Water Intake Pipeline in Plant Piping, Brine-Discharge or Outfall Pipeline.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "City Gas Distribution", desc: "Products Used in: MD House Service Connection, Piped Gas Distribution Network.", img: "/image/solanki_hdpe_pipes.png"},
                { title: "MEP Projects", desc: "Products Used in: Raw-Water & Potable Water/Sewerage Management, Clean-Room, Noise Proofing, Lining.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Construction", desc: "Products Used in: Water & Waste Water Piping, Ground Water Removal, De-Watering Applications.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Chemicals & Process Industries", desc: "Products Used in: Chlor-Alkali, Caustic, Chlorine, Brine, VCM, Agrochemicals, Water & Utilities.", img: "/image/solanki_hdpe_pipes.png"},
                { title: "Oil & Gas Petrochemicals Industries", desc: "Products Used in: DM Gas and Shale Gas Sour Water Stripper Column, Fire-Water Mains.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Mines & Minerals", desc: "Products Used in: Fire-Water Mains, Mines Ventilation Applications, Coal Washery Applications.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Ferrous Metals Extraction", desc: "Products Used in: DM & Coke Oven Area, Metal-Slag, Slurry conveyance and FTP, Sludge Area – Salt Spray Lines.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Non-Ferrous Metals Extraction", desc: "Products Used in: DM / Gas Separation by Acid Leaching, Electrolytic Metal Recovery.",img: "/image/solanki_hdpe_pipes.png" },
                { title: "Battery Industries & Electrical Mobility", desc: "Products Used in: Battery Charging Station, Fume Hoods & Acid Fume Ducting, Acid Proof Lining.",img: "/image/solanki_hdpe_pipes.png" },
                { title: "PV Silicon Wafers & Semi-conductors", desc: "Products Used in: Water Systems and Ultra-Pure Water, DI Water Plant, Water Recycling Plant and Scrubber.",img: "/image/solanki_hdpe_pipes.png" },
                { title: "Thermal Power Plants", desc: "Products Used in: DM Water Plant, Raw Water Pipelines, Fire Water Pipelines, Cooling Towers.", img: "/image/solanki_hdpe_pipes.png"},
                { title: "Nuclear Power Plants", desc: "Products Used in: Raw-Water Pipelines, DM Water Plants, Desalination Plant.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Sea-Water Intake & Outfalls", desc: "Products Used in: Desalination Plants, Sea-Water Cooling, Sea-Water FGD, Sea-Water Fire-Water Mains.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Dredging", desc: "Products Used in: Marine Excavation, Dredging – Sand Removal, Land Re-filling, Water-Ways.", img: "/image/solanki_hdpe_pipes.png" },
                { title: "Green Hydrogen & Ammonia Projects", desc: "Products Used in: Hydrogen Recovery through Electrolysis of Sea-Water.", img: "/image/solanki_hdpe_pipes.png"},
                { title: "Pharmaceuticals, Bulk Drugs & API", desc: "Products Used in: DM Water Plants, DI Water Plants, Pharma Utilities/Noise Scrubbers/ HVAC Systems.",img: "/image/solanki_hdpe_pipes.png" }
            ];
            %>

            <% industries.forEach(item => { %>
                <div class="group bg-[#f9f9f9] border border-gray-200 shadow-sm flex h-full transition-all duration-300 hover:shadow-md hover:bg-white">
                    <div class="w-1/3 min-w-[120px] overflow-hidden border-r border-gray-100">
                        <img src="<%= item.img %>" alt="<%= item.title %>" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
                    </div>

                    <div class="w-2/3 p-5 flex flex-col justify-between">
                        <div>
                            <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wide mb-2 leading-tight group-hover:text-red-700 transition-colors">
                                <%= item.title %>
                            </h3>
                            <p class="text-[12px] leading-relaxed text-slate-500 font-normal">
                                <%= item.desc %>
                            </p>
                        </div>

                        <div class="mt-4 pt-3 border-t border-gray-200 flex justify-between items-center">
                            <div class="flex items-center gap-1">
                                <span class="bg-red-500 p-1 rounded-sm">
                                    <svg class="w-2 h-2 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"></path></svg>
                                </span>
                                <span class="text-[10px] font-bold text-red-600 uppercase tracking-tighter">Products</span>
                            </div>
                            <div class="text-gray-300 group-hover:text-yellow-500 transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>                      

    <%- include('partials/footer') %>
</body>
</html>