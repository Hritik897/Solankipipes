<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<style>
    body {
        font-family: 'Inter', sans-serif;
    }
</style>

<body class="bg-gray-50">
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 py-12">
        <div class="text-center mb-12">
            <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2">We are here to help you</h1>
            <p class="text-gray-600">Kindly fill up the form below to send us your queries</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            
            <div class="space-y-6">
                
                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex items-start space-x-4">
                    <div class="mt-1 text-red-600">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-red-600 uppercase tracking-tight">Raipur Branch Office</h2>
                        <div class="mt-2 text-gray-600 leading-relaxed">
                            <p>Office No. – 6029, 6th Floor</p>
                            <p>Lalganga Currency Tower</p>
                            <p>GE, VIP Road, Vishal Nagar</p>
                            <p>Raipur - 492001, Chhattisgarh</p>
                        </div>
                        <p class="mt-4 text-red-600 font-bold text-lg tracking-wide">Phone: +91 79801 92901</p>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex items-start space-x-4">
                    <div class="mt-1 text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-gray-800">Production Factory - Motiwada, Gujarat</h2>
                        <div class="mt-2 text-gray-600 text-sm leading-relaxed">
                            <p>Sangir Plastics Pvt. Ltd, Survey No 1291, Motiwada,</p>
                            <p>Near Raymond Ltd, NH 8, Pardi, Valsad 396125, Gujarat.</p>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white p-5 rounded-lg border border-gray-100 shadow-sm flex items-center justify-center space-x-3">
                        <span class="text-gray-800 font-bold tracking-wider underline">+91 74000 87538</span>
                    </div>
                    <div class="bg-white p-5 rounded-lg border border-gray-100 shadow-sm flex items-center justify-center space-x-3">
                        <span class="text-gray-800 font-bold text-sm tracking-tighter">emarketing1@sangir.com</span>
                    </div>
                </div>
            </div>

            <div class="bg-white p-8 rounded-lg shadow-md border border-gray-100">
                <form action="/submit-enquiry" method="POST" class="space-y-4">
                    <input type="text" name="name" placeholder="Name" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none">
                    
                    <input type="email" name="email" placeholder="Email" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none">
                    
                    <input type="text" name="mobile" placeholder="Mobile" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none">
                    
                    <input type="text" name="company" placeholder="Company" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none">
                    
                    <input type="text" name="location" placeholder="Location" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none">
                    
                    <textarea name="message" rows="4" placeholder="Message/Enquiry" class="w-full p-3 border border-gray-300 rounded focus:ring-1 focus:ring-red-500 outline-none"></textarea>
                    
                    <button type="submit" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold py-3 px-6 rounded transition-colors uppercase">
                        Submit
                    </button>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>